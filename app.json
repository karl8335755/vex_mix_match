{
  "expo": {
    "name": "Mix & Match Route Planner",
    "slug": "mix-match-route-planner",
    "version": "1.0.0",
    "orientation": "landscape",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vex.mixmatchplanner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.vex.mixmatchplanner",
      "screenOrientation": "landscape"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "scheme": "mixmatch"
  }
}
