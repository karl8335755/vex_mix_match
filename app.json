{
  "expo": {
    "name": "Mix & Match Route Planner",
    "slug": "vex-iq-mixandmatch",
    "version": "1.0.0",
    "orientation": "landscape",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vex.mixmatchplanner"
    },
    "android": {
      "package": "com.vex.mixmatchplanner",
      "screenOrientation": "landscape"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "./plugins/withKotlinVersion.js"
    ],
    "scheme": "mixmatch",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "78cc6030-1c2a-41b1-9ad7-f4cfcc9a10c8"
      }
    },
    "owner": "karl8335755"
  }
}
